{
  "layer": "top",
  "namespace": "overshot-dock",
  "position": "bottom",
  "height": 52,
  "margin": "0 0 6 0",
  "exclusive": false,
  "spacing": 4,
  "modules-left": [],
  "modules-center": ["custom/launcher", "custom/files", "custom/term", "custom/browser", "wlr/taskbar", "custom/settings"],
  "modules-right": [],

  "custom/launcher": { "format": "", "tooltip": "Application launcher (wofi)", "on-click": "wofi --show drun" },
  "custom/files": { "format": "", "tooltip": "Files (Thunar)", "on-click": "thunar" },
  "custom/term": { "format": "", "tooltip": "Terminal (foot)", "on-click": "foot" },
  "custom/browser": { "format": "", "tooltip": "Web browser", "on-click": "overshot-browser" }, // STRIP:browser
  "wlr/taskbar": {
    "format": "{icon}",
    "all-outputs": true,
    "on-click": "activate",
    "on-click-middle": "close",
    "tooltip": true
  },
  "custom/settings": { "format": "", "tooltip": "OVERSHOT settings", "on-click": "overshot-settings" }
}
